 
source="authentication_logs.csv" event_type="FAILURE"
| bin _time span=1m
| stats dc(username) as targeted_accounts count as failed_attempts values(username) as usernames by source_ip _time
| where targeted_accounts >= 5
| eval window_start=strftime(_time,"%Y-%m-%d %H:%M:%S")
| table window_start source_ip failed_attempts targeted_accounts usernames
  